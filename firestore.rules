rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contact enquiries from contact.html and Semil AI chat
    match /contact_enquiries/{docId} {
      // Anyone can submit an enquiry, but only valid entries with name, email and message
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      // Protect user privacy: visitors cannot read, list, update or delete submissions
      allow read, update, delete: if false;
    }

    // Career job applications from careers.html
    match /career_applications/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if false;
    }
  }
}
